      ],
      "destination": "/oracle/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "subdomain.buryad-toli.site"
        }
      ],
      "destination": "/oracle"
    },
    {
      "source": "/:path*",
